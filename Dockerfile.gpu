ARG DOCU_MODELS_IMAGE=natollang/docu-ocr@sha256:7b24a413cbee8e87aa7b2664efbadf6419e5766fcf29daf317b1aae1bba49ec4
FROM ${DOCU_MODELS_IMAGE} AS pretrained

FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    DOCU_SOURCE_DIR=/opt/docu DOCU_MODEL_DIR=/app/model
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgomp1 libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
ARG DOCU_REF=7b98e5ef984f55c9f23f896e67c93c1be0aabddc
RUN git clone https://github.com/CaoAnhNato/vn-identity-card-ocr.git /opt/docu \
    && git -C /opt/docu checkout "$DOCU_REF" \
    && git -C /opt/docu rev-parse HEAD > /opt/docu-upstream-revision
WORKDIR /app
# CUDA 12.8 wheels include Blackwell support (RTX 50-series).
RUN pip install --no-cache-dir torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128
COPY requirements.txt requirements-gpu.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-gpu.txt
COPY requirements-restoration.txt ./
RUN pip install --no-cache-dir -r requirements-restoration.txt
COPY scripts/setup-qr-restoration.py ./scripts/setup-qr-restoration.py
ENV QR_RESTORATION_MODEL_DIR=/opt/qr-restoration
RUN python scripts/setup-qr-restoration.py --directory /opt/qr-restoration
COPY --from=pretrained /app/model /app/model
COPY --from=pretrained /root/.cache/torch /root/.cache/torch
COPY identification_demo ./identification_demo
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/api/v1/health/ready', timeout=4)"
CMD ["python", "-m", "uvicorn", "identification_demo.gpu_worker:app", "--host", "0.0.0.0", "--port", "8081"]
